// Cloudflare Worker (static assets) serving the J&B concept preview:
//   /            the proposal for J&B
//   /website/    the redesigned website
// Used when CLOUDFLARE_API_TOKEN / CLOUDFLARE_ACCOUNT_ID secrets are set on the repo.
{
  "name": "jandbauto-preview",
  "compatibility_date": "2026-10-01",
  "assets": { "directory": "./dist" },
  "routes": [{ "pattern": "jandbauto.hunchopeak.dev", "custom_domain": true }]
}
