// Cloudflare Worker (static assets) for a revamp preview.
// Copy to the repo root, replace CLIENT, point "directory" at the built site.
// Used when the CLOUDFLARE_API_TOKEN / CLOUDFLARE_ACCOUNT_ID repo secrets are set.
{
  "name": "CLIENT-preview",
  "compatibility_date": "2026-10-01",
  "assets": { "directory": "./dist", "not_found_handling": "404-page" },
  "routes": [{ "pattern": "CLIENT.hunchopeak.dev", "custom_domain": true }]
}
