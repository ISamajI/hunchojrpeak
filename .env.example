# --- Identity ---
# Name shown across the command center
AKAMARU_BRAND_NAME=AKUMARU
# Agency details (used in demos and outreach signatures)
AGENCY_NAME=LTGPeak
AGENCY_OWNER=Henry
AGENCY_SITE=
AGENCY_PHONE=

# --- Claude API: AI research, copy, outreach, reply classification ---
ANTHROPIC_API_KEY=
# AKAMARU_MODEL=claude-opus-5-5

# --- Demo imagery: AI concept images (optional; real photos are always preferred) ---
# IMAGE_PROVIDER=openai   with OPENAI_API_KEY   (gpt-image-1)
# IMAGE_PROVIDER=replicate with REPLICATE_API_TOKEN (Flux 1.1 Pro)
IMAGE_PROVIDER=
OPENAI_API_KEY=
REPLICATE_API_TOKEN=
# Max AI images per demo (cost cap)
AKAMARU_IMAGEGEN_MAX=4
# Real-browser QA at 7 breakpoints before any demo ships (needs Playwright): auto | 0
AKAMARU_BROWSER_QA=auto

# --- Discovery (OpenStreetMap works with no key; Google Places adds real photos, rating and reviews) ---
GOOGLE_PLACES_API_KEY=

# --- Preview deploys ---
VERCEL_TOKEN=
VERCEL_TEAM_ID=

# --- Email (sends only after owner approval) ---
RESEND_API_KEY=
OUTREACH_FROM_EMAIL=
OUTREACH_REPLY_TO=
# Required by CAN-SPAM: your physical mailing address, appended to every email
OUTREACH_BUSINESS_ADDRESS=

# --- Owner alerts: SMS / phone call for critical notifications (your own phone only) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# E.164 format, e.g. +19055550100
OWNER_PHONE=

# --- Inbound replies webhook: POST /api/inbound with header x-akamaru-secret ---
AKAMARU_WEBHOOK_SECRET=

# --- Dashboard ---
# Required to bind anything other than 127.0.0.1
AKAMARU_ADMIN_TOKEN=
AKAMARU_PORT=4317
AKAMARU_HOST=127.0.0.1
# Public base URL for local previews (e.g. a tunnel); otherwise previews are local-only
AKAMARU_PUBLIC_URL=
# Minimum opportunity score before Akamaru builds a demo (0-100)
AKAMARU_DEMO_THRESHOLD=40
